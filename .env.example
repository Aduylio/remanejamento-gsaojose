# Copie este arquivo para .env.local apenas se precisar trocar os valores
# de demonstração. Nenhuma variável é obrigatória para rodar localmente.

# Segredo usado na assinatura HMAC do cookie do comprador.
# Gere um valor longo e aleatório em produção.
SESSAO_SECRET=

# Hash scrypt da senha do comprador no formato scrypt$salt$hash.
# Sem esta variável o projeto usa o hash de demonstração descrito no README.
COMPRADOR_SENHA_HASH=

# Use true em produção com HTTPS para marcar os cookies como Secure.
COOKIE_SEGURO=false
