# Copie este arquivo para .env e preencha os valores locais.
# Nenhuma credencial real deve ser versionada.

# Conexão PostgreSQL usada pelo Prisma e pela aplicação.
DATABASE_URL="postgresql://usuario:senha@localhost:5432/remanejamento?schema=public"

# Porta usada por `npm run dev` e `npm run start`.
PORT=4646

# Segredo usado na assinatura HMAC do cookie do comprador.
# Gere um valor longo e aleatório em produção.
SESSAO_SECRET=

# Hash scrypt da senha do comprador no formato scrypt$salt$hash.
# Sem esta variável o projeto usa o hash de demonstração descrito no README.
COMPRADOR_SENHA_HASH=

# Use true em produção com HTTPS para marcar os cookies como Secure.
COOKIE_SEGURO=false

# Seed opcional de um usuário inicial. Se qualquer variável abaixo for
# informada, todas as quatro primeiras são obrigatórias. Nenhuma senha em
# texto puro é aceita: gere o hash scrypt no mesmo formato usado pela aplicação.
SEED_USUARIO_NOME=
SEED_USUARIO_LOGIN=
SEED_USUARIO_SENHA_HASH=
# comprador | filial | administrador
SEED_USUARIO_PAPEL=
# Obrigatório quando SEED_USUARIO_PAPEL=filial (ex.: loja-01).
SEED_USUARIO_FILIAL_ID=

# Lista de proxies reversos confiáveis (separados por vírgula). Enquanto
# estiver vazia, cabeçalhos como X-Forwarded-For/X-Real-IP são ignorados e o
# IP observado fica indisponível. Configure apenas se o proxy remover esses
# cabeçalhos enviados pelo cliente e os reescrever corretamente.
TRUSTED_PROXIES=

# Habilite apenas se quiser bloquear também a origem global (IP) após três
# falhas consecutivas em uma filial. Cuidado com NAT/proxies compartilhados.
BLOQUEIO_GLOBAL_ATIVO=false

# Usada apenas pelos testes de integração opcionais. Nunca aponte para o
# schema de produção; o teste cria e remove um schema temporário isolado.
# TEST_DATABASE_URL=
